{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SquirrelDisk",
  "version": "0.4.0",
  "identifier": "io.github.hernancasillas.squirreldisk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SquirrelDisk",
        "width": 1180,
        "height": 740,
        "minWidth": 820,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "See what's taking up your disk space",
    "longDescription": "SquirrelDisk is a fast, open source disk usage analyzer with an interactive sunburst and treemap. It scans natively on Apple Silicon, Intel, Windows and Linux.",
    "copyright": "AGPL-3.0 - SquirrelDisk contributors",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    },
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
